<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <!-- Fondo del mapa -->
  <rect width="800" height="400" fill="#e8eef0" />
  
  <!-- Calles principales -->
  <line x1="100" y1="0" x2="100" y2="400" stroke="#d1d8e0" stroke-width="15" />
  <line x1="300" y1="0" x2="300" y2="400" stroke="#d1d8e0" stroke-width="15" />
  <line x1="500" y1="0" x2="500" y2="400" stroke="#d1d8e0" stroke-width="15" />
  <line x1="700" y1="0" x2="700" y2="400" stroke="#d1d8e0" stroke-width="15" />
  
  <line x1="0" y1="100" x2="800" y2="100" stroke="#d1d8e0" stroke-width="15" />
  <line x1="0" y1="200" x2="800" y2="200" stroke="#d1d8e0" stroke-width="15" />
  <line x1="0" y1="300" x2="800" y2="300" stroke="#d1d8e0" stroke-width="15" />
  
  <!-- Áreas verdes -->
  <rect x="150" y="50" width="100" height="100" fill="#a5d6a7" rx="10" ry="10" />
  <rect x="550" y="250" width="100" height="100" fill="#a5d6a7" rx="10" ry="10" />
  
  <!-- Edificios -->
  <rect x="120" y="220" width="60" height="40" fill="#b0bec5" />
  <rect x="220" y="120" width="40" height="60" fill="#b0bec5" />
  <rect x="420" y="320" width="60" height="40" fill="#b0bec5" />
  <rect x="620" y="120" width="40" height="60" fill="#b0bec5" />
  
  <!-- Marcadores de tiendas -->
  <circle cx="200" cy="150" r="15" fill="#02A396" />
  <circle cx="350" cy="250" r="15" fill="#02A396" />
  <circle cx="500" cy="150" r="15" fill="#02A396" />
  <circle cx="650" cy="350" r="15" fill="#02A396" />
  
  <!-- Ruta -->
  <path d="M200,150 L350,250 L500,150 L650,350" stroke="#02A396" stroke-width="5" fill="none" stroke-dasharray="10,5" />
</svg> 